{
  "primitive": "Toggle",
  "sourceKind": "vcp-local-contract",
  "status": "candidate-reference",
  "candidateStatus": "vcp-local-contract; no portable Harness toggle primitive or cross-engine parity claim",
  "selectors": {
    ".vcp-uiux-toggle": { "position": "relative", "display": "inline-flex", "alignItems": "center", "width": "36px", "height": "20px" },
    ".vcp-uiux-toggle::before": { "width": "36px", "height": "20px", "borderRadius": "10px", "transition": "background 120ms ease" },
    ".vcp-uiux-toggle::after": { "left": "2px", "width": "16px", "height": "16px", "borderRadius": "50%", "transition": "transform 120ms ease" },
    ".vcp-uiux-toggle:focus-within": { "outline": "2px solid var(--vcp-color-focus,#4c8dff)", "outlineOffset": "2px" }
  },
  "tokens": ["--vcp-color-border", "--vcp-color-brand", "--vcp-color-focus"],
  "root": { "display": "inline-flex", "width": "36px", "height": "20px", "borderRadius": "10px" },
  "thumb": { "width": "16px", "height": "16px", "translateChecked": "16px" },
  "focus": { "outline": "2px solid focus-token", "outlineOffset": "2px" }
}
